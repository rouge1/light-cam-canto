%%{init: {'flowchart': {'curve': 'basis'}, 'theme': 'base'}}%%
flowchart LR
    subgraph LAPTOP["💻 Laptop · post Phase 5 — migration target reached"]
        direction TB
        subgraph SETUP["host/cam_setup.sh"]
            S1["ISP setup<br/>night, mono, ircut"]
            S2["GPIO + process · SSH<br/>ae_freeze write · HTTP"]
        end
        subgraph CAL["host/cal_procedure.py"]
            C1["leds_on_hold<br/>ir850/ir940 ON+OFF"]
            C2["RTSP frame-diff cal<br/>fallback paths"]
        end
        subgraph AIM["host/aim_assist.py"]
            A1["read_grid 4 Hz<br/>brightness_grid<br/>HTTP-first · SSH fallback"]
            A2["set_ae_freeze · HTTP<br/>turn/force_leds · HTTP<br/>kill_cam1_daemon · SSH"]
            A3["preflight<br/>ae read · HTTP<br/>pgrep · HTTP<br/>grid-exists · SSH"]
            A4["restart cam1 daemon<br/>verify via cal-status<br/>or proc-status (HTTP only)"]
            A5["run_bicall + cam1<br/>status poller"]
        end
        subgraph SESS["host/session.py"]
            X1["CamLink: irlink<br/>listen/connect<br/>stdin/stdout pipe"]
            X2["in-band send-hex<br/>STATS / RATE / MSG-HEX"]
            X3["--status-poll<br/>per-cam telemetry"]
        end
    end

    subgraph CAM1["📷 cam1 (dacam1)"]
        direction TB
        H1["lighttpd /x/<br/>json-imp.cgi"]
        H2["lighttpd /x/<br/>cal-status.cgi"]
        H5["lighttpd /x/<br/>brightness-grid.cgi<br/>· Phase 1 ·"]
        H7["lighttpd /x/<br/>ae-freeze.cgi<br/>GET · Phase 2<br/>POST · Phase 3"]
        H9["lighttpd /x/<br/>proc-status.cgi<br/>· Phase 4 ·"]
        SSHD1[sshd]
        IRLINK1["irlink<br/>writes<br/>/run/irlink-status.json"]
        PRUDYNT1["prudynt-patched<br/>/run/prudynt/<br/>brightness_grid<br/>+ ae_freeze"]
        IRLINK1 -.atomic write.-> H2
        PRUDYNT1 -.per-frame.-> H5
        H7 -.atomic temp+rename.-> PRUDYNT1
        H9 -.pgrep+pidof.-> IRLINK1
        H1 -.IMP ctrl.-> PRUDYNT1
    end

    subgraph CAM2["📷 cam2 (dacam2)"]
        direction TB
        H3["lighttpd /x/<br/>json-imp.cgi"]
        H4["lighttpd /x/<br/>cal-status.cgi"]
        H6["lighttpd /x/<br/>brightness-grid.cgi<br/>· Phase 1 ·"]
        H8["lighttpd /x/<br/>ae-freeze.cgi<br/>GET · Phase 2<br/>POST · Phase 3"]
        H10["lighttpd /x/<br/>proc-status.cgi<br/>· Phase 4 ·"]
        SSHD2[sshd]
        IRLINK2["irlink<br/>writes<br/>/run/irlink-status.json"]
        PRUDYNT2["prudynt-patched<br/>/run/prudynt/<br/>brightness_grid<br/>+ ae_freeze"]
        IRLINK2 -.atomic write.-> H4
        PRUDYNT2 -.per-frame.-> H6
        H8 -.atomic temp+rename.-> PRUDYNT2
        H10 -.pgrep+pidof.-> IRLINK2
        H3 -.IMP ctrl.-> PRUDYNT2
    end

